14. Difference between INNER and LEFT JOIN RIGHT JOIN .
---------------- INNER JOIN -------------------
> Select a.CustomerId,a.CustomerNAme,a.City,sum(b.Orderamount) Amount
from Customers A inner join Orders B
on A.Customerid = B.Customerid
group by  a.CustomerId,a.CustomerNAmZZa.City
order by CustomerId desc         ** Only Matching rows

Select a.CustomerId,a.CustomerNAme,a.City,sum(b.Orderamount) Amount
from Customers A Left join Orders B
on A.Customerid = B.Customerid
group by  a.CustomerId,a.CustomerNAme,a.City
order by CustomerId desc   **  All rows from left table Matching Rows from Right Table 

Select a.CustomerId,a.CustomerNAme,a.City,sum(b.Orderamount) Amount
from Customers A Right join Orders B
on A.Customerid = B.Customerid
group by  a.CustomerId,a.CustomerNAme,a.City
order by CustomerId desc   **  All rows from Right table Matching Rows from left Table 


