16. Find employees with highest salary per department.
> SELECT Empid,Empname,Deptcode,takehome from empsal e
  where takehome = (select max(takehome) from empsal where e.DeptCode=DeptCode)
  ORDER BY Empname ASC

17. Find nth highest salary.
> DECLARE @N INT = 1; 
  Select Empid,Empname,Takehome from (
  select Empid,Empname,takehome,DENSE_RANK () over( order by takehome desc) rnk
  from empsal) t 
  where rnk = @N

